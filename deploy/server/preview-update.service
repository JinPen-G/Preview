[Unit]
Description=Update Preview framework with fixed business inputs
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/preview/auto-update.json

[Service]
Type=oneshot
User=preview
Group=preview
WorkingDirectory=/var/lib/preview/update
ExecStart=/usr/bin/flock --nonblock /var/lib/preview/update/job.lock @NODE@ /opt/preview/scripts/update.mjs --config /etc/preview/auto-update.json
ExecStopPost=/usr/bin/flock --nonblock /var/lib/preview/update/job.lock @NODE@ /opt/preview/scripts/update.mjs --config /etc/preview/auto-update.json --cleanup
TimeoutStartSec=30min
TimeoutStopSec=30
KillMode=control-group
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/preview/update /var/lib/preview/data /var/lib/preview/backups /opt/preview/releases /opt/preview/state
Nice=19
CPUQuota=100%
MemoryHigh=3G
MemoryMax=4G
IOSchedulingClass=idle
IOWeight=10
Environment=NODE_OPTIONS=--max-old-space-size=3072
LimitCORE=0

